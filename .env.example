# Server-only PostgreSQL connection. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/dementia_care_hub
API_PORT=3001
# Exact allowed frontend origin(s), comma-separated. Use your HTTPS origin in production.
PUBLIC_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional private local upload location (never a Vite/public folder):
# UPLOAD_DIRECTORY=.local/uploads
# Use `npm run demo` to explicitly select embedded PostgreSQL for a separate local demo.
