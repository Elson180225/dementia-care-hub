{
  "name": "dementia-support-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "content:transfer": "node --env-file-if-exists=.env scripts/transfer-preview-content.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "translations:demo-publish": "node --env-file-if-exists=.env scripts/publish-demo-translations.js",
    "db:migrate:subscribers": "node --env-file-if-exists=.env scripts/migrate-subscribers.js",
    "reminders:preview": "node --env-file-if-exists=.env scripts/reminders.js --dry-run",
    "reminders:run": "node --env-file-if-exists=.env scripts/reminders.js",
    "review-reminders:preview": "node --env-file-if-exists=.env scripts/review-reminder-preview.js",
    "brevo:check": "node --env-file-if-exists=.env scripts/check-brevo.js",
    "brevo:setup": "node --env-file-if-exists=.env scripts/check-brevo.js --setup",
    "admin:invite": "node --env-file-if-exists=.env scripts/invite-admin.js",
    "admin:reset-mfa": "node --env-file-if-exists=.env scripts/reset-admin-mfa.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "db-migrate": "^1.9.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
