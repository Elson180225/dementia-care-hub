{
  "name": "dementia-support-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:migrate:subscribers": "node --env-file-if-exists=.env scripts/migrate-subscribers.js",
    "reminders:preview": "node --env-file-if-exists=.env scripts/reminders.js --dry-run",
    "reminders:run": "node --env-file-if-exists=.env scripts/reminders.js",
    "brevo:check": "node --env-file-if-exists=.env scripts/check-brevo.js",
    "brevo:setup": "node --env-file-if-exists=.env scripts/check-brevo.js --setup",
    "admin:invite": "node --env-file-if-exists=.env scripts/invite-admin.js"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
